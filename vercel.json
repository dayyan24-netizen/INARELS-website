{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/about",       "destination": "/pages/about.html" },
    { "source": "/projects",    "destination": "/pages/projects.html" },
    { "source": "/researchers", "destination": "/pages/researchers.html" },
    { "source": "/portal",      "destination": "/pages/portal.html" }
  ],
  "headers": [
    {
      "source": "/css/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/js/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
